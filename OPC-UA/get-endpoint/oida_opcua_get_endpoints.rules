# ============================================================================
# OIDA OPC UA `--get-endpoints` Fingerprinting Detection - Suricata Rules
# ============================================================================
# Behavioural fingerprint of `oida opcua opc.tcp://<target>:4840 --get-endpoints`
# against an OPC UA server that offers an anonymous endpoint with
# SecurityPolicy#None.
#
# Reference capture : OPC-UA/get-endpoint/get-endpoints.pcapng
#                     (60 packets, 2 TCP streams, loopback, 2026-10-25)
# OIDA source       : src/oida/protocols/opcua/{cli_runner,scanner}.py and
#                     mixins/{discovery,security}.py
# Protocol          : OPC UA Binary over TCP (opc.tcp), default port 4840
#
# OIDA never opens a session for its first discovery pass. It then reconnects,
# creates an anonymous session, reads a fixed set of namespace-0 diagnostic
# nodes, calls GetEndpoints three times, and closes. The rules below match the
# operations; the xbits flags correlate them on the same IP pair.
#
# Correlation via xbits (cross-flow, track ip_pair, expire 30s)
# ============================================================================


# ----------------------------------------------------------------------------
# The OPC UA binary encoding used by these rules
# ----------------------------------------------------------------------------
# Every PDU starts with 3 ASCII type bytes + 1 chunk byte + UInt32 length:
#   HEL / ACK / ERR / OPN / MSG / CLO  +  F | C | A
#
# MSG PDU header (24 bytes):
#   MSGF | size:UInt32 | secureChannelId:UInt32 | tokenId:UInt32 |
#   sequenceNumber:UInt32 | requestId:UInt32
#
# Service body (plaintext when SecurityMode=None):
#   TypeId:NodeId | RequestHeader | <service fields>
#   Standard numeric NodeId, four-byte form: 01 00 <id:UInt16 LE>
#   Standard numeric NodeId, numeric form:   02 00 00 <id:UInt32 LE>
#
# ReadRequest (631) service fields:
#   maxAge:Double | timestampsToReturn:UInt32 |
#   nodesToRead:Int32 | ReadValueId
#   ReadValueId = NodeId | attributeId:UInt32 |
#                 indexRange:String | dataEncoding:QualifiedName
#
# A single-node "read the Value attribute" therefore always contains:
#   01 00 00 00                        nodesToRead count = 1
#   02 00 00 <nodeId:UInt32 LE>        NodeId, namespace 0
#   0D 00 00 00                        AttributeId = Value (13)
#   FF FF FF FF                        IndexRange = null
#   00 00 FF FF FF FF                  DataEncoding = null QualifiedName
# The rules below anchor on that 25-byte block. It is independent of the
# session id, request id, request handle and timestamps.
# ============================================================================


# ----------------------------------------------------------------------------
# RULE 1 : Pre-auth GetEndpoints - discovery without a session
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `connect_and_get_server_endpoints()` opens TCP, HEL/ACK, OPN, then sends
# GetEndpoints on the secure channel while the RequestHeader
# AuthenticationToken is still the null NodeId (00 00). No CreateSession /
# ActivateSession is performed on this TCP stream.
#   TypeId GetEndpointsRequest (428) = 01 00 AC 01
#   AuthenticationToken              = 00 00  (null, two-byte NodeId)
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - pre-auth GetEndpoints (discovery without session)"; \
    flow:to_server,established,no_stream; \
    content:"MSGF"; \
    content:"|01 00 AC 01 00 00|"; distance:0; \
    xbits:set,oida_opcua_preauth_getendpoints,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999930; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 2 : FreeOpcUa / asyncua default client identity in CreateSession
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# OIDA builds `asyncua.Client(url)` without overriding the client description.
# asyncua (the asyncio fork of FreeOpcUa's python-opcua) therefore sends its
# compiled-in defaults in CreateSessionRequest (461):
#   ApplicationUri  urn:example.org:FreeOpcUa:opcua-asyncio
#   ProductUri      urn:freeopcua.github.io:client
#   ApplicationName Pure Python Async Client
# The ProductUri is also the default of the synchronous python-opcua client;
# it identifies the Python FreeOpcUa family, not OIDA alone. The server-side
# ProductUri `urn:freeopcua.github.io:python:server` is a different string and
# belongs to the target stack (the mock), so it is not part of this rule.
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - CreateSession with FreeOpcUa/asyncua default client identity"; \
    flow:to_server,established,no_stream; \
    content:"MSGF"; \
    content:"|01 00 CD 01|"; distance:0; \
    content:"urn:example.org:FreeOpcUa:opcua-asyncio"; distance:0; \
    content:"urn:freeopcua.github.io:client"; distance:0; \
    content:"Pure Python Async Client"; distance:0; \
    xbits:set,oida_opcua_freeopcua_client,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999931; rev:2; \
)


# ----------------------------------------------------------------------------
# RULE 3 : Read Server_ServerStatus_BuildInfo (i=2260)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_get_server_info()` reads ns=0 i=2260 to map product, vendor, version,
# build number, build date and product URI.
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read BuildInfo (ns=0 i=2260)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 D4 08 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_buildinfo,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999932; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 4 : Read Server_Auditing (i=2994)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_check_server_security()` step 1: is activity auditing enabled?
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read Server_Auditing (ns=0 i=2994)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 B2 0B 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_auditing,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999933; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 5 : Read Server_ServerCapabilities_ServerProfileArray (i=2269)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_check_server_security()` step 2: advertised profiles, used to infer RBAC
# support.
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read ServerProfileArray (ns=0 i=2269)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 DD 08 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_profiles,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999934; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 6 : Read Server_ServerDiagnostics_EnabledFlag (i=2294)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_check_server_security()` step 3: diagnostics enabled (information leak).
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read ServerDiagnostics EnabledFlag (ns=0 i=2294)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 F6 08 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_diag_enabled,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999935; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 7 : Read SecurityRejectedSessionCount (i=2279)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_check_server_security()` step 4a: rejected-session counter.
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read SecurityRejectedSessionCount (ns=0 i=2279)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 E7 08 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_rej_sessions,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999936; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 8 : Read SecurityRejectedRequestsCount (i=2287)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_check_server_security()` step 4b: rejected-request counter.
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read SecurityRejectedRequestsCount (ns=0 i=2287)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 EF 08 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_rej_requests,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999937; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 9 : Read CurrentSessionCount (i=2277)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_check_server_security()` step 5: number of active sessions (recon).
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read CurrentSessionCount (ns=0 i=2277)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 E5 08 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_session_count,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999938; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 10 : Read SessionDiagnosticsArray (i=3707)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_check_server_security()` step 6: per-session client application name,
# connection time, subscription counters.
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read SessionDiagnosticsArray (ns=0 i=3707)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 7B 0E 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_session_diag,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999939; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 11 : Read SessionSecurityDiagnosticsArray (i=3708)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_check_server_security()` step 7: user ids, authentication mechanism and
# security mode of every session - credential and configuration mapping.
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read SessionSecurityDiagnosticsArray (ns=0 i=3708)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 7C 0E 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_session_secdiag,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999940; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 12 : Read ServerRedundancy_RedundancySupport (i=3709)
# Priority: 3 (MEDIUM)
# ----------------------------------------------------------------------------
# `_check_server_security()` step 8: redundancy mode of the server.
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - read ServerRedundancy RedundancySupport (ns=0 i=3709)"; \
    flow:to_server,established,no_stream; \
    content:"|01 00 00 00 02 00 00 7D 0E 00 00 0D 00 00 00 FF FF FF FF 00 00 FF FF FF FF|"; \
    xbits:set,oida_opcua_read_redundancy,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:3; \
    sid:9999941; rev:1; \
)


# ----------------------------------------------------------------------------
# RULE 13 : Three GetEndpoints in the same authenticated session
# Priority: 2 (HIGH)
# ----------------------------------------------------------------------------
# OIDA calls get_endpoints() three times on the same session:
#   1. `_check_certificate()`            -> server certificate inspection
#   2. endpoint count for the JSON result
#   3. `--get-endpoints` dispatch        -> `_get_endpoints()` display
# In the capture the three requests are 2-3 ms apart, with an identical
# EndpointUrl. The AuthenticationToken is a four-byte NodeId (01 00 ...),
# unlike the pre-auth request (00 00).
# threshold type both = alert once when the 3rd request enters the window.
# `flow:no_stream` is required: Suricata coalesces the three requests into one
# stream chunk and reports at most one match per rule per chunk. At packet
# level each request is evaluated separately, so the counter works. The xbits
# flag is set on the first match (Suricata applies threshold after detection);
# the correlation rule below therefore counts GetEndpointsResponses itself
# instead of trusting that flag as the 3-request gate.
# ----------------------------------------------------------------------------

alert tcp any any -> any 4840 (\
    msg:"OPCUA OIDA - repeated GetEndpoints (3 in 3s) on an authenticated session"; \
    flow:to_server,established,no_stream; \
    content:"MSGF"; \
    content:"|01 00 AC 01 01 00|"; distance:0; \
    threshold:type both, track by_both, count 3, seconds 3; \
    xbits:set,oida_opcua_getendpoints_repeat,track ip_pair,expire 30; \
    classtype:attempted-recon; \
    priority:2; \
    sid:9999942; rev:1; \
)


# ============================================================================
# CORRELATION RULE (xbits cross-flow, 30 second window)
# ============================================================================

# ----------------------------------------------------------------------------
# RULE 14 : CORRELATION 13/13 - OIDA OPC UA endpoint-mapping fingerprint
# Priority: 1 (CRITICAL)
# ----------------------------------------------------------------------------
# Fires when the same IP pair produced, inside the 30-second xbits window:
#   - pre-auth GetEndpoints without a session
#   - CreateSession with FreeOpcUa/asyncua default client identity
#   - BuildInfo read
#   - all nine diagnostics / security reads
#   - three GetEndpoints responses within 3 seconds
#
# Direction: GetEndpointsResponse (MSG, TypeId 431 = 01 00 AF 01) from the
# server. `threshold:type both, count 3` is the real "3x GetEndpoints" gate:
# the first two responses match the rule but stay below the count, the third
# raises the alert. The GetEndpoints-request flag is present but cannot gate
# the count, because Suricata sets xbits on every match before it applies
# threshold suppression.
#
# Verified against the reference capture:
#   full capture            -> all 14 rules alert
#   frames 1-13 only        -> only 9999930 (pre-auth), no correlation
#   frames 14-60 only       -> 12 rules, no correlation (no pre-auth flag)
#   capture without frame 29-> 12 rules, no correlation (no BuildInfo flag)
# ----------------------------------------------------------------------------

alert tcp any 4840 -> any any (\
    msg:"OPCUA CRITICAL - OIDA endpoint mapping fingerprint (pre-auth discovery + FreeOpcUa client session + 10 ns=0 reads + 3x GetEndpoints in 3s)"; \
    flow:to_client,established; \
    content:"MSGF"; \
    content:"|01 00 AF 01|"; distance:0; \
    xbits:isset,oida_opcua_preauth_getendpoints,track ip_pair; \
    xbits:isset,oida_opcua_freeopcua_client,track ip_pair; \
    xbits:isset,oida_opcua_read_buildinfo,track ip_pair; \
    xbits:isset,oida_opcua_read_auditing,track ip_pair; \
    xbits:isset,oida_opcua_read_profiles,track ip_pair; \
    xbits:isset,oida_opcua_read_diag_enabled,track ip_pair; \
    xbits:isset,oida_opcua_read_rej_sessions,track ip_pair; \
    xbits:isset,oida_opcua_read_rej_requests,track ip_pair; \
    xbits:isset,oida_opcua_read_session_count,track ip_pair; \
    xbits:isset,oida_opcua_read_session_diag,track ip_pair; \
    xbits:isset,oida_opcua_read_session_secdiag,track ip_pair; \
    xbits:isset,oida_opcua_read_redundancy,track ip_pair; \
    xbits:isset,oida_opcua_getendpoints_repeat,track ip_pair; \
    threshold:type both, track by_both, seconds 3, count 3; \
    classtype:attempted-recon; \
    priority:1; \
    sid:9999950; rev:1; \
)
