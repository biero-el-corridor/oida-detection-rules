# Regenerate the global Suricata rule set from the per-protocol files.
# The per-protocol files are the source of truth.

SURICATA ?= suricata
RULES := oida_detection.rules
S7 := s7comm/s7 -i/oida_s7_-i_detection.rules
OPCUA := OPC-UA/get-endpoint/oida_opcua_get_endpoints.rules

.PHONY: all rules test test-opcua test-s7 clean

all: rules

rules:
	@{ \
	  echo '# ============================================================================'; \
	  echo '# OIDA Detection Rules - global rule set'; \
	  echo '# ============================================================================'; \
	  echo '# Generated from:'; \
	  echo '#   - s7comm/s7 -i/oida_s7_-i_detection.rules'; \
	  echo '#   - OPC-UA/get-endpoint/oida_opcua_get_endpoints.rules'; \
	  echo '# Do not edit this file; edit the protocol file and run `make rules`.'; \
	  echo '# ============================================================================'; \
	  echo; \
	  cat "$(S7)"; \
	  echo; echo; \
	  cat "$(OPCUA)"; \
	} > $(RULES)

test-opcua: rules
	@rm -rf /tmp/oida-test-opcua; mkdir -p /tmp/oida-test-opcua
	$(SURICATA) -r OPC-UA/get-endpoint/get-endpoints.pcapng -S $(RULES) -l /tmp/oida-test-opcua --runmode single -k none
	@printf 'OPC UA SIDs: '; grep -o '\[1:[0-9]*' /tmp/oida-test-opcua/fast.log | sed 's/\[1://' | sort -n | uniq | tr '\n' ' '; echo

test-s7: rules
	@rm -rf /tmp/oida-test-s7; mkdir -p /tmp/oida-test-s7
	$(SURICATA) -r "s7comm/s7 -i/oida_-i_snap7.pcapng" -S $(RULES) -l /tmp/oida-test-s7 --runmode single -k none
	@printf 'S7 SIDs: '; grep -o '\[1:[0-9]*' /tmp/oida-test-s7/fast.log | sed 's/\[1://' | sort -n | uniq | tr '\n' ' '; echo

test: test-opcua test-s7

clean:
	rm -f $(RULES)
	rm -rf /tmp/oida-test-opcua /tmp/oida-test-s7
